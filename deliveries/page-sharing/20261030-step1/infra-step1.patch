diff --git a/packages/orchestrator/internal/sandbox/build/pin.go b/packages/orchestrator/internal/sandbox/build/pin.go
new file mode 100644
index 000000000..42c41050e
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/build/pin.go
@@ -0,0 +1,174 @@
+package build
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+
+	"github.com/jellydator/ttlcache/v3"
+)
+
+// cachedDiff owns exactly one Diff. Closing the cache's reference retires it;
+// the final pin closes the underlying mapping. The mutex also makes eviction
+// and acquiring a pin atomic even though ttlcache invokes callbacks async.
+type cachedDiff struct {
+	Diff
+	original Diff
+	mu       sync.Mutex
+	pins     int
+	retired  bool
+	closed   bool
+	closeErr error
+}
+
+func newCachedDiff(original, owned Diff) *cachedDiff {
+	return &cachedDiff{Diff: owned, original: original}
+}
+
+func (d *cachedDiff) pin() (*PinnedDiff, bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.retired {
+		return nil, false
+	}
+	d.pins++
+	return &PinnedDiff{entry: d}, true
+}
+
+func (d *cachedDiff) closeIfUnused() error {
+	if d.retired && d.pins == 0 && !d.closed {
+		d.closed = true
+		d.closeErr = d.Diff.Close()
+	}
+	return d.closeErr
+}
+
+func (d *cachedDiff) Close() error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.retired = true
+	return d.closeIfUnused()
+}
+
+// PinnedDiff is an owned reference independent of cache membership. Close is
+// idempotent and drains this handle's in-flight reads before dropping its pin.
+type PinnedDiff struct {
+	entry    *cachedDiff
+	mu       sync.RWMutex
+	closed   bool
+	closeErr error
+}
+
+func (d *PinnedDiff) Close() error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.closed {
+		d.closed = true
+		d.entry.mu.Lock()
+		d.entry.pins--
+		d.closeErr = d.entry.closeIfUnused()
+		d.entry.mu.Unlock()
+	}
+	return d.closeErr
+}
+
+func (d *PinnedDiff) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	d.mu.RLock()
+	defer d.mu.RUnlock()
+	if d.closed {
+		return 0, os.ErrClosed
+	}
+	return d.entry.Diff.ReadAt(ctx, p, off)
+}
+
+func (d *PinnedDiff) Slice(ctx context.Context, off, length int64) ([]byte, error) {
+	d.mu.RLock()
+	defer d.mu.RUnlock()
+	if d.closed {
+		return nil, os.ErrClosed
+	}
+	return d.entry.Diff.Slice(ctx, off, length)
+}
+
+// Pin acquires a cache entry without ever returning a borrowed Diff. Opening a
+// remote object and allocating its sparse cache does not fetch its RAM payload.
+// Initialization is serialized with publication so failed/partial objects are
+// never observed by another acquisition.
+func (s *DiffStore) Pin(ctx context.Context, candidate Diff) (*PinnedDiff, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	key := candidate.CacheKey()
+	s.resetDelete(key)
+	if item := s.cache.Get(key); item != nil {
+		entry, ok := item.Value().(*cachedDiff)
+		if !ok {
+			return nil, fmt.Errorf("unowned cache entry %s", key)
+		}
+		if pin, ok := entry.pin(); ok {
+			return pin, nil
+		}
+		// An eviction callback may have retired this exact entry between Get
+		// and pin. Never resurrect a retired mapping.
+		s.cache.Delete(key)
+	}
+	if err := candidate.Init(ctx); err != nil {
+		return nil, fmt.Errorf("failed to init source: %w", err)
+	}
+	owned, err := ownDiff(candidate)
+	if err != nil {
+		return nil, err
+	}
+	entry := newCachedDiff(candidate, owned)
+	pin, _ := entry.pin()
+	// An expired item is invisible to Get, but Set updates it in place and
+	// does not run eviction callbacks. Delete it explicitly to retire its owner.
+	s.cache.Delete(key)
+	s.cache.Set(key, entry, ttlcache.DefaultTTL)
+	return pin, nil
+}
+
+func ownDiff(d Diff) (Diff, error) {
+	if local, ok := d.(*localDiff); ok {
+		return local.transferToStore()
+	}
+	return d, nil
+}
+
+// localDiffStoreOwner bypasses the original snapshot handle's Close after its
+// ownership has been transferred to the cache. This prevents Snapshot cleanup
+// from unmapping RAM still used by a pinned source.
+type localDiffStoreOwner struct{ *localDiff }
+
+func (d *localDiffStoreOwner) Close() error { return d.localDiff.closeOwned() }
+
+func (d *localDiff) transferToStore() (Diff, error) {
+	d.ownerMu.Lock()
+	defer d.ownerMu.Unlock()
+	if d.ownerClosed {
+		return nil, os.ErrClosed
+	}
+	if d.storeOwned {
+		return nil, errors.New("local diff ownership already transferred")
+	}
+	d.storeOwned = true
+	return &localDiffStoreOwner{d}, nil
+}
+
+func (d *localDiff) closeOwned() error {
+	d.ownerMu.Lock()
+	defer d.ownerMu.Unlock()
+	return d.closeOwnedLocked()
+}
+
+func (d *localDiff) closeOwnedLocked() error {
+	if !d.ownerClosed {
+		d.ownerClosed = true
+		d.ownerCloseErr = d.cache.Close()
+	}
+	return d.ownerCloseErr
+}
diff --git a/packages/orchestrator/internal/sandbox/build/pin_test.go b/packages/orchestrator/internal/sandbox/build/pin_test.go
new file mode 100644
index 000000000..8283adcef
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/build/pin_test.go
@@ -0,0 +1,328 @@
+package build
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/cfg"
+	blockmetrics "github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/block/metrics"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+type pinTestDiff struct {
+	NoDiff
+	key     DiffStoreKey
+	data    []byte
+	reads   atomic.Int32
+	closes  atomic.Int32
+	inits   atomic.Int32
+	initErr error
+	entered chan struct{}
+	resume  chan struct{}
+}
+
+func (d *pinTestDiff) CacheKey() DiffStoreKey     { return d.key }
+func (d *pinTestDiff) Init(context.Context) error { d.inits.Add(1); return d.initErr }
+func (d *pinTestDiff) Close() error               { d.closes.Add(1); return nil }
+func (d *pinTestDiff) FileSize() (int64, error)   { return int64(len(d.data)), nil }
+func (d *pinTestDiff) ReadAt(_ context.Context, p []byte, off int64) (int, error) {
+	if d.entered != nil {
+		close(d.entered)
+		<-d.resume
+	}
+	d.reads.Add(1)
+	if d.closes.Load() != 0 {
+		return 0, os.ErrClosed
+	}
+	return copy(p, d.data[off:]), nil
+}
+
+func pinTestStore(t *testing.T, ttl time.Duration) *DiffStore {
+	t.Helper()
+	s, err := NewDiffStore(cfg.Config{}, nil, t.TempDir(), ttl, time.Hour)
+	require.NoError(t, err)
+	t.Cleanup(s.RemoveCache)
+	return s
+}
+
+func waitPinTest(t *testing.T, f func() bool) {
+	t.Helper()
+	require.Eventually(t, f, 3*time.Second, time.Millisecond)
+}
+
+func TestPinnedFileSurvivesInvalidationAndLastViewClosesOnce(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	a, b := uuid.New(), uuid.New()
+	da := &pinTestDiff{key: GetDiffStoreKey(a.String(), Memfile), data: bytes.Repeat([]byte{0x31}, 8192)}
+	db := &pinTestDiff{key: GetDiffStoreKey(b.String(), Memfile), data: bytes.Repeat([]byte{0x72}, 4096)}
+	s.Add(da)
+	s.Add(db)
+	h, err := header.NewHeader(&header.Metadata{Version: 3, Size: 16384, BlockSize: 4096}, []*header.BuildMap{
+		{Offset: 0, Length: 4096, BuildId: a},
+		{Offset: 4096, Length: 4096, BuildId: b},
+		{Offset: 8192, Length: 4096, BuildId: uuid.Nil},
+		{Offset: 12288, Length: 4096, BuildId: a, BuildStorageOffset: 4096},
+	})
+	require.NoError(t, err)
+	f := NewFile(h, s, Memfile, nil, blockmetrics.Metrics{})
+	v1, err := f.Pin(t.Context())
+	require.NoError(t, err)
+	v2, err := f.Pin(t.Context())
+	require.NoError(t, err)
+	require.Len(t, v1.diffs, 2)
+	require.Zero(t, da.reads.Load(), "pinning must not fetch RAM payload")
+	require.Zero(t, db.reads.Load())
+	entry := v1.diffs[a].entry
+	s.RemoveCache()
+	waitPinTest(t, func() bool { entry.mu.Lock(); defer entry.mu.Unlock(); return entry.retired })
+	// The view owns its manifest as well as its unread backing objects.
+	h.Mapping[0].BuildId = uuid.New()
+	got := bytes.Repeat([]byte{0xff}, 16384)
+	_, err = v1.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	want := append(bytes.Repeat([]byte{0x31}, 4096), bytes.Repeat([]byte{0x72}, 4096)...)
+	want = append(want, make([]byte, 4096)...)
+	want = append(want, bytes.Repeat([]byte{0x31}, 4096)...)
+	require.Equal(t, want, got)
+	require.NoError(t, v1.Close())
+	require.Zero(t, da.closes.Load())
+	require.Zero(t, db.closes.Load())
+	_, err = v2.ReadAt(t.Context(), got[:512], 17)
+	require.NoError(t, err)
+	require.NoError(t, v2.Close())
+	require.NoError(t, v2.Close())
+	waitPinTest(t, func() bool { return da.closes.Load() == 1 && db.closes.Load() == 1 })
+	_, err = v2.ReadAt(t.Context(), got, 0)
+	require.ErrorIs(t, err, os.ErrClosed)
+}
+
+func TestPinnedDiffSurvivesTTLAndExpiredReplacementRetiresOwner(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, 10*time.Millisecond)
+	old := &pinTestDiff{key: "ttl", data: []byte("original")}
+	s.Add(old)
+	first, err := s.Pin(t.Context(), &pinTestDiff{key: old.key})
+	require.NoError(t, err)
+	time.Sleep(25 * time.Millisecond)
+	// No Start/DeleteExpired: exercise the expired-but-still-present Set path.
+	replacement := &pinTestDiff{key: old.key, data: []byte("replaced")}
+	second, err := s.Pin(t.Context(), replacement)
+	require.NoError(t, err)
+	waitPinTest(t, func() bool { first.entry.mu.Lock(); defer first.entry.mu.Unlock(); return first.entry.retired })
+	b := make([]byte, 8)
+	_, err = first.ReadAt(t.Context(), b, 0)
+	require.NoError(t, err)
+	require.Equal(t, "original", string(b))
+	require.Zero(t, old.closes.Load())
+	require.NoError(t, first.Close())
+	require.EqualValues(t, 1, old.closes.Load())
+	_, err = second.ReadAt(t.Context(), b, 0)
+	require.NoError(t, err)
+	require.Equal(t, "replaced", string(b))
+	s.RemoveCache()
+	require.NoError(t, second.Close())
+	waitPinTest(t, func() bool { return replacement.closes.Load() == 1 })
+}
+
+func TestPinnedDiffSurvivesAutomaticTTLEviction(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, 20*time.Millisecond)
+	go s.cache.Start()
+	t.Cleanup(s.cache.Stop)
+	d := &pinTestDiff{key: "automatic-ttl", data: []byte{0x51}}
+	pin, err := s.Pin(t.Context(), d)
+	require.NoError(t, err)
+	waitPinTest(t, func() bool { pin.entry.mu.Lock(); defer pin.entry.mu.Unlock(); return pin.entry.retired })
+	require.False(t, s.Has(d))
+	require.Zero(t, d.closes.Load())
+	got := []byte{0}
+	_, err = pin.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, []byte{0x51}, got)
+	require.NoError(t, pin.Close())
+	require.EqualValues(t, 1, d.closes.Load())
+}
+
+type pinFailStorage struct{ storage.StorageProvider }
+
+func (pinFailStorage) OpenSeekable(context.Context, string, storage.SeekableObjectType) (storage.Seekable, error) {
+	return nil, errors.New("remote object unavailable")
+}
+
+func TestPinnedFilePartialAcquisitionReleasesPins(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	a, b := uuid.New(), uuid.New()
+	d := &pinTestDiff{key: GetDiffStoreKey(a.String(), Memfile), data: []byte{1}}
+	require.NoError(t, s.Add(d))
+	h, err := header.NewHeader(&header.Metadata{Version: 3, Size: 8192, BlockSize: 4096}, []*header.BuildMap{
+		{Offset: 0, Length: 4096, BuildId: a}, {Offset: 4096, Length: 4096, BuildId: b},
+	})
+	require.NoError(t, err)
+	f := NewFile(h, s, Memfile, pinFailStorage{}, blockmetrics.Metrics{})
+	view, err := f.Pin(t.Context())
+	require.ErrorContains(t, err, "remote object unavailable")
+	require.Nil(t, view)
+	s.RemoveCache()
+	waitPinTest(t, func() bool { return d.closes.Load() == 1 })
+}
+
+func TestDiffPinFailedStorageInitDoesNotHangClose(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	d, err := newStorageDiff(s.cachePath, uuid.NewString(), Memfile, 4096, blockmetrics.Metrics{}, pinFailStorage{}, nil)
+	require.NoError(t, err)
+	_, err = s.Pin(t.Context(), d)
+	require.ErrorContains(t, err, "remote object unavailable")
+	done := make(chan error, 1)
+	go func() { done <- d.Close() }()
+	select {
+	case err := <-done:
+		require.ErrorContains(t, err, "remote object unavailable")
+	case <-time.After(time.Second):
+		t.Fatal("failed initialization left Close waiting forever")
+	}
+}
+
+func TestDiffPinAddRejectsClosedLocalDiff(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	d := newRootFSDiff(t, s.cachePath, "closed-local")
+	require.NoError(t, d.Close())
+	require.ErrorIs(t, s.Add(d), os.ErrClosed)
+	require.False(t, s.Has(d))
+}
+
+func TestLocalDiffOwnershipTransferProtectsPinnedSource(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	id := uuid.New()
+	f, err := NewLocalDiffFile(s.cachePath, id.String(), Memfile)
+	require.NoError(t, err)
+	want := bytes.Repeat([]byte{0x7a}, 4096)
+	_, err = f.Write(want)
+	require.NoError(t, err)
+	d, err := f.CloseToDiff(4096)
+	require.NoError(t, err)
+	s.Add(d)
+	pin, err := s.Pin(t.Context(), &pinTestDiff{key: d.CacheKey()})
+	require.NoError(t, err)
+	// Simulate Snapshot.Close, then template invalidation and build eviction.
+	require.NoError(t, d.Close())
+	s.RemoveCache()
+	waitPinTest(t, func() bool { pin.entry.mu.Lock(); defer pin.entry.mu.Unlock(); return pin.entry.retired })
+	got := make([]byte, 4096)
+	_, err = pin.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, want, got)
+	path, err := d.CachePath()
+	require.NoError(t, err)
+	require.FileExists(t, path)
+	require.NoError(t, pin.Close())
+	require.NoError(t, pin.Close())
+	require.NoError(t, d.Close())
+	_, err = os.Stat(path)
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
+
+func TestPinnedDiffCloseDrainsRead(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	d := &pinTestDiff{key: "blocked", data: []byte{1}, entered: make(chan struct{}), resume: make(chan struct{})}
+	pin, err := s.Pin(t.Context(), d)
+	require.NoError(t, err)
+	s.RemoveCache()
+	readDone := make(chan error, 1)
+	go func() { _, err := pin.ReadAt(t.Context(), make([]byte, 1), 0); readDone <- err }()
+	<-d.entered
+	closed := make(chan error, 1)
+	go func() { closed <- pin.Close() }()
+	select {
+	case <-closed:
+		t.Fatal("closed an in-flight source read")
+	case <-time.After(10 * time.Millisecond):
+	}
+	require.Zero(t, d.closes.Load())
+	close(d.resume)
+	require.NoError(t, <-readDone)
+	require.NoError(t, <-closed)
+	waitPinTest(t, func() bool { return d.closes.Load() == 1 })
+}
+
+func TestDiffPinInitializationAndConcurrentInvalidation(t *testing.T) {
+	t.Parallel()
+	s := pinTestStore(t, time.Hour)
+	failed := &pinTestDiff{key: "failed", initErr: errors.New("open failed")}
+	_, err := s.Pin(t.Context(), failed)
+	require.ErrorContains(t, err, "open failed")
+	require.False(t, s.Has(failed))
+	var wg sync.WaitGroup
+	var allMu sync.Mutex
+	var all []*pinTestDiff
+	for g := range 8 {
+		wg.Go(func() {
+			for i := range 30 {
+				d := &pinTestDiff{key: DiffStoreKey(fmt.Sprintf("key-%d", g%2)), data: []byte{7}}
+				allMu.Lock()
+				all = append(all, d)
+				allMu.Unlock()
+				if i%3 == 0 {
+					s.Add(d)
+				}
+				candidate := &pinTestDiff{key: d.key, data: []byte{7}}
+				allMu.Lock()
+				all = append(all, candidate)
+				allMu.Unlock()
+				pin, err := s.Pin(t.Context(), candidate)
+				if !assertPinNoError(t, err) {
+					continue
+				}
+				if i%2 == 0 {
+					s.RemoveCache()
+				}
+				b := make([]byte, 1)
+				_, err = pin.ReadAt(t.Context(), b, 0)
+				assertPinNoError(t, err)
+				if b[0] != 7 {
+					t.Errorf("wrong source byte: %d", b[0])
+				}
+				assertPinNoError(t, pin.Close())
+			}
+		})
+	}
+	wg.Wait()
+	s.RemoveCache()
+	// Some candidates hit existing entries and were never initialized/owned.
+	waitPinTest(t, func() bool {
+		for _, d := range all {
+			if d.inits.Load() > 0 && d.closes.Load() != 1 {
+				return false
+			}
+		}
+		return true
+	})
+	for _, d := range all {
+		require.LessOrEqual(t, d.closes.Load(), int32(1))
+	}
+}
+
+func assertPinNoError(t *testing.T, err error) bool {
+	t.Helper()
+	if err != nil {
+		t.Error(err)
+		return false
+	}
+	return true
+}
diff --git a/packages/orchestrator/internal/sandbox/build/pinned_file.go b/packages/orchestrator/internal/sandbox/build/pinned_file.go
new file mode 100644
index 000000000..410b788c7
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/build/pinned_file.go
@@ -0,0 +1,107 @@
+package build
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/block"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// PinnedFile owns the manifest and one pin per unique nonzero backing Diff.
+// Its lifetime is independent of both the template and the build cache. Pinning
+// opens sparse backing objects but never reads/materializes their RAM payload.
+type PinnedFile struct {
+	header   *header.Header
+	diffs    map[uuid.UUID]*PinnedDiff
+	mu       sync.RWMutex
+	closed   bool
+	closeErr error
+}
+
+var _ block.ReadonlyDevice = (*PinnedFile)(nil)
+
+func (b *File) Pin(ctx context.Context) (*PinnedFile, error) {
+	if b.header == nil || b.header.Metadata == nil {
+		return nil, fmt.Errorf("cannot pin a file without a manifest")
+	}
+	// Snapshot the manifest so a caller retaining the template cannot mutate the
+	// view's translation or substitute an unpinned object after acquisition.
+	metadata := *b.header.Metadata
+	mappings := make([]*header.BuildMap, len(b.header.Mapping))
+	for i, mapping := range b.header.Mapping {
+		if mapping == nil {
+			return nil, fmt.Errorf("nil manifest extent")
+		}
+		copy := *mapping
+		mappings[i] = &copy
+	}
+	h, err := header.NewHeader(&metadata, mappings)
+	if err != nil {
+		return nil, err
+	}
+	view := &PinnedFile{header: h, diffs: make(map[uuid.UUID]*PinnedDiff)}
+	for _, mapping := range h.Mapping {
+		id := mapping.BuildId
+		if id == uuid.Nil || view.diffs[id] != nil {
+			continue
+		}
+		candidate, err := b.storageDiff(&id)
+		var pin *PinnedDiff
+		if err == nil {
+			pin, err = b.store.Pin(ctx, candidate)
+		}
+		if err != nil {
+			return nil, errors.Join(fmt.Errorf("pin backing %s: %w", id, err), view.Close())
+		}
+		view.diffs[id] = pin
+	}
+	return view, nil
+}
+
+func (b *PinnedFile) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	b.mu.RLock()
+	defer b.mu.RUnlock()
+	if b.closed {
+		return 0, os.ErrClosed
+	}
+	return readLogicalAt(ctx, b.header, p, off, func(ctx context.Context, id uuid.UUID, p []byte, off int64) (int, error) {
+		diff := b.diffs[id]
+		if diff == nil {
+			return 0, fmt.Errorf("manifest references unpinned backing %s", id)
+		}
+		return diff.ReadAt(ctx, p, off)
+	})
+}
+
+// Slice returns a copy so its lifetime does not escape an in-flight read and
+// race Close. NBD uses ReadAt, so this does not add payload copies to that path.
+func (b *PinnedFile) Slice(ctx context.Context, off, length int64) ([]byte, error) {
+	if length < 0 || length > int64(int(^uint(0)>>1)) {
+		return nil, fmt.Errorf("invalid slice length")
+	}
+	p := make([]byte, int(length))
+	n, err := b.ReadAt(ctx, p, off)
+	return p[:n], err
+}
+
+func (b *PinnedFile) Size(context.Context) (int64, error) { return int64(b.header.Metadata.Size), nil }
+func (b *PinnedFile) BlockSize() int64                    { return int64(b.header.Metadata.BlockSize) }
+func (b *PinnedFile) Header() *header.Header              { return b.header }
+
+func (b *PinnedFile) Close() error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if !b.closed {
+		b.closed = true
+		for _, diff := range b.diffs {
+			b.closeErr = errors.Join(b.closeErr, diff.Close())
+		}
+	}
+	return b.closeErr
+}
