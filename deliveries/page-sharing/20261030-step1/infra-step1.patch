+			sendNBD(t, client, NBDCmdRead, 1, tc.from, tc.length, nil)
+			receiveNBD(t, client, 1, uint32(syscall.EIO), 0)
+			select {
+			case <-d.Done():
+			case <-time.After(time.Second):
