+	id := testIdentity
+	id.LayoutID = "wrong"
+	s := &testSource{id: id}
+	r := NewRegistry(func(context.Context, SnapshotIdentity) (SnapshotSource, error) { return s, nil }, func(context.Context, SnapshotSource) (Backing, error) {
+		t.Fatal("mismatched identity reached factory")
+		return nil, nil
+	})
+	if _, err := r.Acquire(ctx, testIdentity); err == nil {
+		t.Fatal("accepted wrong logical source")
+	}
+	if err := r.Drain(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if s.closes.Load() != 1 {
+		t.Fatal("mismatched source leaked")
+	}
+}
+
+func TestRegistryAcquireWithSourceUsesOnlyCreatorAndFailedCleanupGatesRetry(t *testing.T) {
+	ctx := testContext(t)
+	failed := newTestBacking()
+	failed.closeStarted, failed.closeGate = make(chan struct{}), make(chan struct{})
+	gate := make(chan struct{})
+	boom := errors.New("failed after device allocation")
+	var creates, opens atomic.Int32
+	r := NewRegistry(nil, func(context.Context, SnapshotSource) (Backing, error) {
+		if creates.Add(1) == 1 {
+			<-gate
+			return failed, boom
+		}
+		return newTestBacking(), nil
+	})
+	open := func(_ context.Context, id SnapshotIdentity) (SnapshotSource, error) {
+		opens.Add(1)
+		return &testSource{id: id}, nil
+	}
+	const n = 8
+	errs := make(chan error, n)
+	for range n {
+		go func() { _, err := r.AcquireWithSource(ctx, testIdentity, open); errs <- err }()
+	}
+	waitRefs(t, r, testIdentity, n)
+	close(gate)
+	<-failed.closeStarted
+	for range n {
+		if err := <-errs; !errors.Is(err, boom) {
+			t.Fatal(err)
+		}
+	}
+	// A cleanup can outlive all failed waiters, yet new acquisitions must not
+	// retarget its device until the factory's allocated resource disconnects.
+	newLease := make(chan *Lease, 1)
+	go func() {
+		l, err := r.AcquireWithSource(ctx, testIdentity, open)
+		if err != nil {
+			t.Error(err)
+		}
+		newLease <- l
+	}()
+	if creates.Load() != 1 || opens.Load() != 1 {
+		t.Fatal("retried during old disconnect")
+	}
+	close(failed.closeGate)
+	l := <-newLease
+	if l == nil {
+		t.Fatal("retry failed")
+	}
+	other, err := r.AcquireWithSource(ctx, testIdentity, func(context.Context, SnapshotIdentity) (SnapshotSource, error) {
+		t.Error("ready reuse called a second opener")
+		return nil, errors.New("must not open")
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if opens.Load() != 2 {
+		t.Fatalf("source opener calls %d", opens.Load())
+	}
+	if err := other.Release(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Release(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Drain(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRegistryDrainDuringFailedCreation(t *testing.T) {
+	ctx := testContext(t)
+	started, finish := make(chan struct{}), make(chan struct{})
+	s := &testSource{id: testIdentity}
+	r := NewRegistry(func(context.Context, SnapshotIdentity) (SnapshotSource, error) { return s, nil }, func(context.Context, SnapshotSource) (Backing, error) {
+		close(started)
+		<-finish
+		return nil, errors.New("factory failure")
+	})
+	acquired := make(chan error, 1)
+	go func() { _, err := r.Acquire(ctx, testIdentity); acquired <- err }()
+	<-started
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := r.Drain(canceled); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	drained := make(chan error, 1)
+	go func() { drained <- r.Drain(ctx) }()
+	close(finish)
+	if err := <-acquired; err == nil {
+		t.Fatal("creation failed successfully")
+	}
+	if err := <-drained; err != nil {
+		t.Fatal(err)
+	}
+	if s.closes.Load() != 1 {
+		t.Fatal("source close count")
+	}
+}
+
+func TestRegistryDisconnectFailureQuarantinesIdentityAndPreservesSource(t *testing.T) {
+	ctx := testContext(t)
+	boom := errors.New("disconnect acknowledgement timed out")
+	b := newTestBacking()
+	b.closeErr = boom
+	s := &testSource{id: testIdentity}
+	var creates atomic.Int32
+	r := NewRegistry(func(context.Context, SnapshotIdentity) (SnapshotSource, error) { return s, nil }, func(context.Context, SnapshotSource) (Backing, error) { creates.Add(1); return b, nil })
+	l, err := r.Acquire(ctx, testIdentity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Release(ctx); !errors.Is(err, boom) {
+		t.Fatal(err)
+	}
+	if err := l.Release(ctx); !errors.Is(err, boom) {
+		t.Fatal(err)
+	}
+	if s.closes.Load() != 0 {
+		t.Fatal("source closed despite unconfirmed device disconnect")
+	}
+	if _, err := r.Acquire(ctx, testIdentity); !errors.Is(err, boom) {
+		t.Fatal("quarantined identity reused or did not fail promptly", err)
+	}
+	if creates.Load() != 1 {
+		t.Fatal("quarantined source was retargeted")
+	}
+	if err := r.Drain(ctx); !errors.Is(err, boom) {
+		t.Fatal("drain falsely reported safe teardown", err)
+	}
+	if err := r.Drain(ctx); !errors.Is(err, boom) {
+		t.Fatal("repeated drain lost quarantine error", err)
+	}
+	r.mu.Lock()
+	e := r.entries[testIdentity]
+	r.mu.Unlock()
+	if e == nil || e.source != s || e.backing != b {
+		t.Fatal("quarantine lost ownership of failed resource")
+	}
+	if s.closes.Load() != 0 || b.closes.Load() != 1 {
+		t.Fatal("quarantine retried teardown automatically")
+	}
+}
diff --git a/packages/orchestrator/internal/sandbox/memorybacking/source.go b/packages/orchestrator/internal/sandbox/memorybacking/source.go
new file mode 100644
index 000000000..529a5446d
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/memorybacking/source.go
@@ -0,0 +1,150 @@
+// Package memorybacking owns immutable snapshot sources and shared device leases.
+package memorybacking
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+)
+
+// SnapshotIdentity identifies logical bytes, never an ephemeral path or NBD number.
+// LayoutID must identify the ordered logical RAM regions and page size.
+type SnapshotIdentity struct {
+	Kind        string
+	ContentID   string
+	LayoutID    string
+	LogicalSize int64
+}
+
+func (id SnapshotIdentity) Validate() error {
+	if id.Kind == "" || id.ContentID == "" || id.LayoutID == "" || id.LogicalSize <= 0 {
+		return errors.New("snapshot identity requires kind, content ID, layout ID and positive logical size")
+	}
+	return nil
+}
+
+type SnapshotSource interface {
+	Identity() SnapshotIdentity
+	ReadAt(context.Context, []byte, int64) (int, error)
+	Close() error
+}
+
+// LogicalReader is implemented by block.ReadonlyDevice, including layered memfiles.
+type LogicalReader interface {
+	ReadAt(context.Context, []byte, int64) (int, error)
+	Size(context.Context) (int64, error)
+}
+
+type SourceOptions struct {
+	MaxReadBytes       int
+	MaxConcurrentReads int
+	// Close transfers ownership of a reader to the source. Nil borrows the reader;
+	// this is required when a template owns the shared memfile.
+	Close func() error
+}
+
+type LocalSource struct {
+	id       SnapshotIdentity
+	reader   LogicalReader
+	limit    int
+	slots    chan struct{}
+	mu       sync.RWMutex
+	closed   bool
+	close    func() error
+	closeErr error
+}
+
+func sourceLimits(o SourceOptions) (int, int, error) {
+	if o.MaxReadBytes < 0 || o.MaxConcurrentReads < 0 {
+		return 0, 0, errors.New("negative source limit")
+	}
+	if o.MaxReadBytes == 0 {
+		o.MaxReadBytes = 4 << 20
+	}
+	if o.MaxConcurrentReads == 0 {
+		o.MaxConcurrentReads = 8
+	}
+	return o.MaxReadBytes, o.MaxConcurrentReads, nil
+}
+
+func NewLocalSource(ctx context.Context, id SnapshotIdentity, reader LogicalReader, opts SourceOptions) (*LocalSource, error) {
+	if err := id.Validate(); err != nil {
+		return nil, err
+	}
+	if reader == nil {
+		return nil, errors.New("nil snapshot reader")
+	}
+	limit, concurrency, err := sourceLimits(opts)
+	if err != nil {
+		return nil, err
+	}
+	size, err := reader.Size(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("snapshot size: %w", err)
+	}
+	if size != id.LogicalSize {
+		return nil, fmt.Errorf("snapshot size %d differs from manifest %d", size, id.LogicalSize)
+	}
+	return &LocalSource{id: id, reader: reader, limit: limit, slots: make(chan struct{}, concurrency), close: opts.Close}, nil
+}
+
+func (s *LocalSource) Identity() SnapshotIdentity { return s.id }
+
+func validateRead(id SnapshotIdentity, p []byte, off int64, limit int) error {
+	if off < 0 || off > id.LogicalSize || int64(len(p)) > id.LogicalSize-off {
+		return errors.New("snapshot read outside logical size")
+	}
+	if len(p) > limit {
+		return fmt.Errorf("snapshot request exceeds %d byte bound", limit)
+	}
+	return nil
+}
+
+func (s *LocalSource) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	if err := validateRead(s.id, p, off, s.limit); err != nil {
+		return 0, err
+	}
+	select {
+	case s.slots <- struct{}{}:
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+	defer func() { <-s.slots }()
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	if s.closed {
+		return 0, io.ErrClosedPipe
+	}
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+	n, err := s.reader.ReadAt(ctx, p, off)
+	if n < 0 || n > len(p) {
+		return 0, errors.New("snapshot reader returned invalid count")
+	}
+	if n != len(p) {
+		return n, errors.Join(io.ErrUnexpectedEOF, err)
+	}
+	if errors.Is(err, io.EOF) {
+		err = nil
+	}
+	return n, err
+}
+
+// Close waits for active reads before closing the owned reader, at most once.
+func (s *LocalSource) Close() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.closed {
+		s.closed = true
+		if s.close != nil {
+			s.closeErr = s.close()
+		}
+	}
+	return s.closeErr
+}
diff --git a/packages/orchestrator/internal/sandbox/memorybacking/source_test.go b/packages/orchestrator/internal/sandbox/memorybacking/source_test.go
new file mode 100644
index 000000000..ef1fb5127
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/memorybacking/source_test.go
@@ -0,0 +1,244 @@
+package memorybacking
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type byteReader struct {
+	data   []byte
+	short  bool
+	closes atomic.Int32
+}
+
+func (r *byteReader) Size(context.Context) (int64, error) { return int64(len(r.data)), nil }
+func (r *byteReader) ReadAt(_ context.Context, p []byte, off int64) (int, error) {
+	if r.short {
+		return 0, nil
+	}
+	return bytes.NewReader(r.data).ReadAt(p, off)
+}
+func (r *byteReader) Close() error { r.closes.Add(1); return nil }
+
+func TestLocalSourceBoundsFullReadsAndBorrowedOwnership(t *testing.T) {
+	ctx := testContext(t)
+	data := make([]byte, testIdentity.LogicalSize)
+	for i := range data {
+		data[i] = byte(i % 253)
+	}
+	// An explicit zero extent remains a zero extent; unaccessed nonzero bytes
+	// remain nonzero and must never be inferred from residency.
+	clear(data[4096:6144])
+	r := &byteReader{data: data}
+	s, err := NewLocalSource(ctx, testIdentity, r, SourceOptions{MaxReadBytes: 4096})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, rr := range [][2]int64{{0, 4096}, {4095, 2}, {6140, 10}, {8191, 1}, {4096, 2048}, {8192, 0}} {
+		p := make([]byte, rr[1])
+		n, err := s.ReadAt(ctx, p, rr[0])
+		if err != nil || n != len(p) || !bytes.Equal(p, data[rr[0]:rr[0]+rr[1]]) {
+			t.Fatalf("range %v n=%d err=%v", rr, n, err)
+		}
+	}
+	for _, rr := range [][2]int64{{-1, 1}, {8192, 1}, {math.MaxInt64, 2}, {0, 4097}} {
+		if _, err := s.ReadAt(ctx, make([]byte, rr[1]), rr[0]); err == nil {
+			t.Fatalf("accepted invalid range %v", rr)
+		}
+	}
+	r.short = true
+	if _, err := s.ReadAt(ctx, make([]byte, 4), 0); !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("short read succeeded: %v", err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if r.closes.Load() != 0 {
+		t.Fatal("borrowed template reader closed")
+	}
+	if _, err := s.ReadAt(ctx, make([]byte, 1), 0); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatal(err)
+	}
+	owned, err := NewLocalSource(ctx, testIdentity, r, SourceOptions{Close: r.Close})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = owned.Close()
+	_ = owned.Close()
+	if r.closes.Load() != 1 {
+		t.Fatal("owned reader close count")
+	}
+	id := testIdentity
+	id.LogicalSize++
+	if _, err := NewLocalSource(ctx, id, r, SourceOptions{}); err == nil {
+		t.Fatal("accepted wrong size")
+	}
+}
+
+func TestHTTPSourceDemandRangesAndFaults(t *testing.T) {
+	data := make([]byte, testIdentity.LogicalSize)
+	for i := range data {
+		data[i] = byte(i % 251)
+	}
+	for _, fault := range []string{"ok", "short", "wrong-range", "changed-version", "ignore-range", "checksum", "trailing", "encoding", "server-error"} {
+		t.Run(fault, func(t *testing.T) {
+			ctx := testContext(t)
+			var requested atomic.Int64
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("If-Match") != "\"fixed-version\"" {
+					t.Error("request did not pin manifest version")
+				}
+				w.Header().Set("ETag", "\"fixed-version\"")
+				if r.Method == http.MethodHead {
+					w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+					return
+				}
+				var start, end int64
+				if _, err := fmt.Sscanf(r.Header.Get("Range"), "bytes=%d-%d", &start, &end); err != nil {
+					t.Error(err)
+					w.WriteHeader(400)
+					return
+				}
+				requested.Add(end - start + 1)
+				w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(data)))
+				payload := append([]byte(nil), data[start:end+1]...)
+				switch fault {
+				case "wrong-range":
+					w.Header().Set("Content-Range", "bytes 0-1/8192")
+				case "changed-version":
+					w.Header().Set("ETag", "\"new-version\"")
+				case "ignore-range":
+					w.WriteHeader(200)
+					_, _ = w.Write(data)
+					return
+				case "checksum":
+					payload[0] ^= 1
+				case "short":
+					payload = payload[:len(payload)-1]
+				case "trailing":
+					payload = append(payload, 1)
+				case "encoding":
+					w.Header().Set("Content-Encoding", "gzip")
+				case "server-error":
+					w.WriteHeader(503)
+					return
+				}
+				// Chunked responses exercise exact-body checks separately from length.
+				w.WriteHeader(http.StatusPartialContent)
+				w.(http.Flusher).Flush()
+				_, _ = w.Write(payload)
+			}))
+			defer server.Close()
+			want := sha256.Sum256(data[4090:4122])
+			s, err := NewHTTPSource(ctx, testIdentity, server.URL, HTTPOptions{ETag: "\"fixed-version\"", VerifyRange: func(_ int64, b []byte) error {
+				if sha256.Sum256(b) != want {
+					return errors.New("digest mismatch")
+				}
+				return nil
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer s.Close()
+			p := make([]byte, 32)
+			n, err := s.ReadAt(ctx, p, 4090)
+			if fault == "ok" {
+				if err != nil || n != len(p) || !bytes.Equal(p, data[4090:4122]) {
+					t.Fatalf("n=%d err=%v", n, err)
+				}
+			} else if err == nil {
+				t.Fatalf("fault %s returned success", fault)
+			}
+			if requested.Load() != 32 {
+				t.Fatalf("demand request read %d bytes", requested.Load())
+			}
+		})
+	}
+}
+
+func TestHTTPSourceCanceledReadDoesNotCancelPeersAndCloseCancelsReads(t *testing.T) {
+	ctx := testContext(t)
+	started := make(chan struct{}, 2)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", "\"v1\"")
+		if r.Method == http.MethodHead {
+			w.Header().Set("Content-Length", "8192")
+			return
+		}
+		started <- struct{}{}
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	s, err := NewHTTPSource(ctx, testIdentity, server.URL, HTTPOptions{ETag: "\"v1\"", SourceOptions: SourceOptions{MaxConcurrentReads: 2}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	one := make(chan error, 1)
+	two := make(chan error, 1)
+	go func() { _, err := s.ReadAt(canceled, make([]byte, 1), 0); one <- err }()
+	<-started
+	go func() { _, err := s.ReadAt(ctx, make([]byte, 1), 1); two <- err }()
+	<-started
+	cancel()
+	if err := <-one; !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-two:
+		t.Fatalf("peer canceled: %v", err)
+	default:
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- s.Close() }()
+	select {
+	case err := <-two:
+		if err == nil {
+			t.Fatal("close returned read success")
+		}
+	case <-ctx.Done():
+		t.Fatal("close did not cancel active request")
+	}
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestHTTPManifestAndRequestLimits(t *testing.T) {
+	ctx := testContext(t)
+	for _, etag := range []string{"", "W/\"weak\"", "unquoted"} {
+		if _, err := NewHTTPSource(ctx, testIdentity, "http://unused", HTTPOptions{ETag: etag}); err == nil {
+			t.Fatalf("accepted ETag %q", etag)
+		}
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", "\"v1\"")
+		w.Header().Set("Content-Length", "4096")
+	}))
+	defer server.Close()
+	if _, err := NewHTTPSource(ctx, testIdentity, server.URL, HTTPOptions{ETag: "\"v1\""}); err == nil {
+		t.Fatal("accepted changed logical size")
+	}
+	// A delayed HEAD observes the caller deadline; it cannot leave a half-ready source.
+	delayed := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { <-r.Context().Done() }))
+	defer delayed.Close()
+	deadline, cancel := context.WithTimeout(ctx, 20*time.Millisecond)
+	defer cancel()
+	if _, err := NewHTTPSource(deadline, testIdentity, delayed.URL, HTTPOptions{ETag: "\"v1\""}); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal(err)
+	}
+}
